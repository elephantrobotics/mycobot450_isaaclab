format: xrdf
format_version: 2.0

# Preview-only: sphere keys are USD paths under /mycobot_pro450.
# Do not pass this file to cuMotion. Use config/robot.xrdf for planning.

default_joint_positions:
  joint1: 0.0
  joint2: 0.0
  joint3: 0.0
  joint4: 0.0
  joint5: 0.0
  joint6: 0.0
  joint2_left_joint: -1.01

cspace:
  joint_names:
    - "joint1"
    - "joint2"
    - "joint3"
    - "joint4"
    - "joint5"
    - "joint6"
  acceleration_limits: [12.0, 12.0, 12.0, 12.0, 12.0, 12.0]
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0, 500.0]

tool_frames: ["f100_base_link"]

world_collision:
  geometry: "pro450_f100_collision_spheres"

self_collision:
  geometry: "pro450_f100_collision_spheres"

geometry:
  pro450_f100_collision_spheres:
    spheres:
      "Geometry/base_link":
        - center: [-0.02450, 0.00000, 0.08750]
          radius: 0.09950
